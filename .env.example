# Supabase — optional.
# Without these the app still works: progress is saved in the browser only.
# With them: magic-link login + progress synced across devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used for magic-link redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

GOOGLE_TTS_API_KEY=