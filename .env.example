# ---------------------------------------------------------------------------
# Accounts are optional. With none of this set, the app runs exactly as before:
# every test works and progress is kept in the browser.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. Setting this switches accounts on.
MONGODB_URI=
MONGODB_DB=uebungstests

# Used for the links inside e-mails, which cannot be relative. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# E-mail. Without these, sign-up still works in development: the confirmation
# link is printed to the terminal instead of being sent. In production the app
# refuses to pretend and reports an error instead.
# ---------------------------------------------------------------------------

# https://resend.com — free tier is 3.000 e-mails a month
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend
MAIL_FROM="Deutsch Übungstests <noreply@ihre-domain.de>"

# ---------------------------------------------------------------------------
# Audio generation (see public/audio/README.md)
# ---------------------------------------------------------------------------

GOOGLE_TTS_API_KEY=
